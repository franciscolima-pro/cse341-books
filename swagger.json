      "post": {
        "tags": [
          "Authors"
        ],
        "summary": "Create an author",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "birthYear": {
                    "type": "number"
                  }
                }
              },
              "example": {
                "id": "a4",
                "name": "Example Author",
                "birthYear": 1980
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "birthYear": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Required fields are missing or the author ID already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "examples": {
                        "missingFields": {
                          "value": "Missing required author fields."
                        },
                        "duplicateId": {
                          "value": "Author id already exists."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unable to create author",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Unable to create author."
                    }
                  }
                }
              }
            }
          }
        }
      }
